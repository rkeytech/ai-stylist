# Copy this file to .env.local and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. The vision defaults work on the free tier;
# try-on image generation needs billing enabled on your Google AI Studio project.
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Used automatically while the main model is overloaded or unavailable (set to empty to disable)
# GEMINI_VISION_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image

# Set to "true" to run every AI feature with offline mock responses
# (no key needed - useful for local testing of the full flow).
AI_MOCK=false

# Where the SQLite database and private uploads live (default: ./data)
# DATA_DIR=./data
