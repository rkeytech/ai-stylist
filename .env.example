# Copy this file to .env.local and fill in your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: an ordered, comma-separated list of models to try in turn. Put the free models you want
# first, then any paid ones you're willing to fall back to (cheapest first) - a paid model is only
# ever called if every model before it fails (busy, rate-limited, or unavailable). Browse current
# free (":free" suffix) and paid models + live pricing at https://openrouter.ai/models.
# Paid fallbacks need a small credit balance at https://openrouter.ai/credits.
#
# Default: OPENROUTER_VISION_MODELS=openrouter/free,openai/gpt-4.1-nano
#
# A fuller example with several free models tried first, then two cheap paid ones:
# OPENROUTER_VISION_MODELS=openrouter/free,google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash-vl:free,openai/gpt-4.1-nano,google/gemini-2.5-flash-lite

# Set to "true" to run every AI feature with offline mock responses
# (no key needed - useful for local testing of the full flow).
AI_MOCK=false

# Where the SQLite database and private uploads live (default: ./data)
# DATA_DIR=./data

# Note: Try-On (camera + AI image generation) is temporarily disabled - this app has no
# image-generation provider configured. See src/lib/ai.ts.
